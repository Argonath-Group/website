# Optional — canonical site URL used for metadataBase, sitemap, robots,
# and OG tags. Falls back to https://argonathgroup.com when unset.
# NEXT_PUBLIC_SITE_URL=

# Optional — Supabase backing for the /api/apply route.
# The site builds and runs fully without these; the apply endpoint
# simply reports that applications are not open when they are unset.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
