# Optional — canonical site URL used for metadataBase, sitemap, robots,
# and OG tags. Falls back to https://argonathgroup.com when unset.
# NEXT_PUBLIC_SITE_URL=

# Optional — server-only Resend notifications for /api/inquire (D-028).
# Never expose these with NEXT_PUBLIC_. RESEND_FROM must be an address on a
# domain verified in Resend — unverified domains are rejected by the API
# (notification failures are non-fatal; the inquiry is still stored).
# RESEND_API_KEY=
# RESEND_FROM=

# Optional — Supabase backing for the /api/inquire route (D-026).
# The site builds and runs fully without these; the endpoint returns 404
# and CTAs render as mailto links when they are unset.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
